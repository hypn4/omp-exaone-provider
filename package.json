{
  "name": "omp-exaone-provider",
  "version": "0.1.2",
  "description": "K-EXAONE 2.5 model provider plugin for Oh My Pi (OMP), supporting streaming, reasoning, and tool calling",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypn4/omp-exaone-provider.git"
  },
  "homepage": "https://github.com/hypn4/omp-exaone-provider#readme",
  "bugs": {
    "url": "https://github.com/hypn4/omp-exaone-provider/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.4",
  "keywords": ["oh-my-pi", "omp", "omp-plugin", "exaone", "k-exaone", "k-exaone-2.5", "lg-ai-research", "llm", "coding-agent", "ai-agent", "model-provider", "typescript"],
  "files": ["src", "README.md", "README.ko.md", "LICENSE"],
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check:types": "bun check --no-script -p tsconfig.json",
    "check": "bun run check:types && bun test",
    "test": "bun test",
    "test:live": "bun run scripts/smoke.ts",
    "preversion": "bun run check",
    "version": "bun install --lockfile-only && git add bun.lock",
    "release:version": "bun pm version --message \"chore(release): v%s\""
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.18.3 <19",
    "@oh-my-pi/pi-coding-agent": ">=18.18.3 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.18.3",
    "@oh-my-pi/pi-catalog": "18.18.3",
    "@oh-my-pi/pi-coding-agent": "18.18.3",
    "@types/bun": "1.4.4"
  }
}
